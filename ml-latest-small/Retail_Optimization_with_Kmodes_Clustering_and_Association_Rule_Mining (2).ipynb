    "# Group genres per movie and attach clusters\n",
    "genres_grouped = movies_expanded.groupby('movieId')['genres'].apply(list).reset_index()\n",
    "genres_grouped = pd.merge(genres_grouped, movies_with_titles[['movieId', 'Cluster']], on='movieId')\n",
    "\n",
    "# Dictionary to hold rules per cluster\n",
    "cluster_rules_dict = {}\n",
    "\n",
    "# Loop through each cluster and apply ARM\n",
    "for cid in sorted(genres_grouped['Cluster'].unique()):\n",
    "    genre_lists = genres_grouped[genres_grouped['Cluster'] == cid]['genres'].tolist()\n",
    "\n",
    "    # Encode\n",
    "    te = TransactionEncoder()\n",
    "    matrix = te.fit(genre_lists).transform(genre_lists)\n",
    "    df_cluster = pd.DataFrame(matrix, columns=te.columns_)\n",
    "\n",
    "    # Apriori and ARM\n",
    "    frequent_itemsets = apriori(df_cluster, min_support=0.05, use_colnames=True)\n",
    "    if not frequent_itemsets.empty:\n",
    "        rules = association_rules(frequent_itemsets, metric='lift', min_threshold=1.0)\n",
    "        cluster_rules_dict[cid] = rules.sort_values(by='lift', ascending=False)\n",
    "        print(f\"\\nTop Rules for Cluster {cid}:\\n\")\n",
    "        print(rules[['antecedents', 'consequents', 'support', 'confidence', 'lift']].head(3))\n",
    "    else:\n",
    "        print(f\"\\nNo frequent genre rules found for Cluster {cid}\")\n"
   ]
